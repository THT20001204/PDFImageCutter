# AI 拆分配置（可选，不配置则使用纯 CV 算法）
# 选一个供应商即可：openai / claude / qwen / zhipu
AI_PROVIDER=zhipu
AI_API_KEY=your-api-key-here

# 以下为可选项，有默认值
# AI_MODEL=glm-4v-flash
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- 各供应商默认值参考 ----
# openai:  model=gpt-4o          base_url=https://api.openai.com/v1
# claude:  model=claude-sonnet-4-20250514  base_url=https://api.anthropic.com
# qwen:   model=qwen-vl-max     base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
# zhipu:  model=glm-4v-flash    base_url=https://open.bigmodel.cn/api/paas/v4
